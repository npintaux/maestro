{
  "schema": "maestro/design-tokens@1",
  "description": "Corporate default design tokens. Projects override by pointing validate_ui_spec.py at a project-local design-system directory. Every color/font/size/space value a ui-spec references MUST resolve to a token here (zero magic values); the validator denies raw literals.",
  "color": {
    "brand-primary": "#1A56DB",
    "brand-primary-hover": "#1E429F",
    "brand-on-primary": "#FFFFFF",
    "surface": "#FFFFFF",
    "surface-alt": "#F3F4F6",
    "on-surface": "#111827",
    "on-surface-muted": "#4B5563",
    "border": "#D1D5DB",
    "danger": "#B91C1C",
    "on-danger": "#FFFFFF",
    "success": "#047857",
    "on-success": "#FFFFFF"
  },
  "font": {
    "family-sans": "Inter, system-ui, sans-serif",
    "family-mono": "JetBrains Mono, ui-monospace, monospace"
  },
  "font-size": {
    "caption": "12px",
    "body": "16px",
    "title": "20px",
    "heading": "28px",
    "display": "40px"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "pill": "9999px"
  }
}
